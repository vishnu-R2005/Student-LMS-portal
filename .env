# Django
DJANGO_SECRET_KEY=change-me-in-production-long-random
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
USE_POSTGRES=False

# Postgres (when USE_POSTGRES=True)
POSTGRES_DB=lms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EMAIL_SUBJECT=[LMS] Password reset
PASSWORD_RESET_FAIL_SILENT=True

# API throttles (DRF)
THROTTLE_ANON=120/hour
THROTTLE_USER=8000/day
THROTTLE_LOGIN=35/hour

# Logging
LOG_LEVEL=INFO

# Production TLS (when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
