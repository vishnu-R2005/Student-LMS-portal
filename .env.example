# Django
DJANGO_SECRET_KEY=change-me-in-production-long-random
DEBUG=False
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com,http://localhost:5173,http://127.0.0.1:5173
USE_POSTGRES=False

# Postgres (when USE_POSTGRES=True)
POSTGRES_DB=lms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EMAIL_SUBJECT=[LMS] Password reset
PASSWORD_RESET_FAIL_SILENT=True

# API throttles (DRF)
THROTTLE_ANON=120/hour
THROTTLE_USER=8000/day
THROTTLE_LOGIN=35/hour
THROTTLE_REGISTER=20/hour
THROTTLE_PASSWORD_RESET_REQUEST=15/hour
THROTTLE_PASSWORD_RESET_CONFIRM=30/hour

# Logging
LOG_LEVEL=INFO

# Production TLS (when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Gunicorn (optional tuning)
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info
